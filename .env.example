# 聯絡表單寄信設定（複製本檔為 .env 後填入實際值；.env 已在 .gitignore 中，不會被 commit）

# 寄件用的 Gmail 帳號
NUXT_MAIL_USER=your-account@gmail.com

# Gmail「應用程式密碼」（16 碼，不是 Gmail 登入密碼）
# 需先開啟 Google 帳戶的兩步驟驗證，再到 https://myaccount.google.com/apppasswords 產生
NUXT_MAIL_PASS=

# 收件信箱（表單內容寄到這裡；留空則寄給 NUXT_MAIL_USER 自己）
NUXT_MAIL_TO=

# 網站正式網址（不含結尾斜線），用於 canonical、分享卡片與 sitemap 的完整網址；留空則依目前請求的網址推算
NUXT_PUBLIC_SITE_URL=

# Instagram 貼文（Gallery 頁）：留空或取不到時，改用備用內容（server/fallback/instagram-posts.json）
# Instagram 專業帳號編號（1784… 開頭，在 Meta App 後台 Instagram 的 API 設定頁可看到）
NUXT_INSTAGRAM_USER_ID=
# 存取權杖（EAA… 開頭）；屬於機密，只放在 .env，不要 commit 或貼到其他地方
NUXT_INSTAGRAM_ACCESS_TOKEN=
# Meta App 編號與密鑰：設定後伺服器會自動檢查權杖效期，並換成不會過期的粉專權杖（App 後台「應用程式設定 → 基本資料」）
# 密鑰屬於機密，只放在 .env
NUXT_INSTAGRAM_APP_ID=
NUXT_INSTAGRAM_APP_SECRET=

# Behance 作品（Gallery 頁 Works）：預設帳號寫在 nuxt.config.ts，要換帳號時才需要設定（公開資訊，不是機密）
# 取不到時改用備用內容（server/fallback/behance-works.json）
# NUXT_BEHANCE_USERNAME=
