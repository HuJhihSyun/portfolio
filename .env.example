# 聯絡表單寄信設定（複製本檔為 .env 後填入實際值；.env 已在 .gitignore 中，不會被 commit）

# 寄件用的 Gmail 帳號
NUXT_MAIL_USER=your-account@gmail.com

# Gmail「應用程式密碼」（16 碼，不是 Gmail 登入密碼）
# 需先開啟 Google 帳戶的兩步驟驗證，再到 https://myaccount.google.com/apppasswords 產生
NUXT_MAIL_PASS=

# 收件信箱（表單內容寄到這裡；留空則寄給 NUXT_MAIL_USER 自己）
NUXT_MAIL_TO=

# 網站正式網址（不含結尾斜線），用於 canonical、分享卡片與 sitemap 的完整網址；留空則依目前請求的網址推算
NUXT_PUBLIC_SITE_URL=
